/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "paths": {
      "lib-components": ["./dist/lib-components"],
      "lib-servicios": ["./dist/lib-servicios"]
    },
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "strictPropertyInitialization": false 
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./projects/lib-components/tsconfig.lib.json"
    },
    {
      "path": "./projects/lib-components/tsconfig.spec.json"
    },
    {
      "path": "./projects/lib-generales/tsconfig.lib.json"
    },
    {
      "path": "./projects/lib-generales/tsconfig.spec.json"
    },
    {
      "path": "./projects/lib-servicios/tsconfig.lib.json"
    },
    {
      "path": "./projects/lib-servicios/tsconfig.spec.json"
    }
  ]
}
